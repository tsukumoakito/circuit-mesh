#!/usr/bin/env bash

ZIG_VER_FILE="$PWD/.zigversion"

if [ -f "$ZIG_VER_FILE" ] && command -v zvm >/dev/null 2>&1; then
    ZIG_VERSION=$(grep -v '^#' "$ZIG_VER_FILE" | tr -d '[:space:]')

    if [ -n "$ZIG_VERSION" ]; then
        CURRENT_ZIG=$(zig version 2>/dev/null || echo "")
        if [ "$CURRENT_ZIG" != "$ZIG_VERSION" ]; then
            zvm use "$ZIG_VERSION"
        fi
    fi
fi
